# Local development / verification profile (zero-dependency).
# The canonical production datasource is PostgreSQL — see .env.example.
DATABASE_URL="file:./dev.db"

# Auth.js
AUTH_SECRET="dev-only-secret-change-me-in-production-9f2c4b71a6d8e3"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# First admin account created by prisma/seed.mjs
ADMIN_EMAIL="admin@libertyenterprises.online"
ADMIN_PASSWORD="Liberty@2026"

# Public business configuration (owner-supplied values only — leave blank if unknown)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_BUSINESS_PHONE=""
BUSINESS_EMAIL="hello@libertyenterprises.online"

# Optional Cloudinary media storage. Without these, uploads are stored in public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
