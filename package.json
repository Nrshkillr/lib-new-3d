    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "db:local": "node scripts/setup-local-db.mjs",
    "migrate:crawl": "node scripts/crawl-legacy.mjs",
    "migrate:report": "node scripts/build-migration-report.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@react-three/fiber": "9.8.2",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "cloudinary": "2.11.0",
    "framer-motion": "14.8.0",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swiper": "14.3.0",
    "tailwind-merge": "3.4.0",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
