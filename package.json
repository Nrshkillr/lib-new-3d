    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
