{
  "name": "liberty-enterprises-wholesale",
  "version": "1.0.0",
  "private": true,
  "description": "LIBERTY ENTERPRISES — premium wholesale baby & kids products platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:production": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:generate:local": "prisma generate --schema prisma/schema.local.prisma",
