# ── Production configuration ──────────────────────────────────────────────
# PostgreSQL (Neon, Supabase, RDS, self-hosted…)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/liberty?schema=public&sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="https://your-domain.com"

# First admin (only used by the seed script)
ADMIN_EMAIL="owner@your-domain.com"
ADMIN_PASSWORD="use-a-strong-unique-password"

# Public business configuration — enter only owner-verified values.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="9198XXXXXXXX"
NEXT_PUBLIC_BUSINESS_PHONE="+91 98XXXXXXXX"
BUSINESS_EMAIL="hello@your-domain.com"

# Cloudinary (recommended for production media persistence)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
